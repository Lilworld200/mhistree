# Copy to .env.local in the rebuild worktree only. Do not copy legacy secrets.
# Prefer a least-privileged application database role, never a public browser secret.
DATABASE_URL=
DATABASE_SSL=verify-full
# Safe connection lifecycle/counter diagnostics only; no SQL or credentials.
DB_DEBUG=0
# Supabase root CA for verified PostgreSQL TLS (public certificate, not a credential):
DATABASE_SSL_CA_FILE=config/certs/supabase-ca.crt
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server key never reaches the browser. The older anon key is supported as a fallback.
# Allow APP_ORIGIN/auth/callback?flow=signup and ?flow=recovery redirects.
# Email confirmation must be enabled. SMTP is configured separately in Supabase.
# Dedicated server-only cookie encryption key: 32 random bytes encoded as 64 hex characters.
AUTH_FLOW_COOKIE_KEY=

APP_ORIGIN=http://127.0.0.1:3101
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_PATIENT_MODEL=gemini-3.1-flash-lite
AI_EXTRACTION_MODEL=gemini-3.1-flash-lite
# Server terminal diagnostics: on by default in development, off in production.
# 1 enables; 0 silences. Metadata only, never prompts/patient text/private reasoning.
AI_DEBUG=1
# Required for production, private durable filesystem outside public/:
PRIVATE_STORAGE_ROOT=

# Microphone messages are available to all signed-in accounts using the existing
# GEMINI_API_KEY and AUTH_FLOW_COOKIE_KEY above. No speech enable flag, allowlist
# or application speech-quota settings are required. Provider free-tier limits apply.
